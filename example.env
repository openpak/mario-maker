# mario-maker: the OpenPak course site for Super Mario Maker (Wii U) and Super Mario Maker 2
# (Switch). Copy to .env; never commit .env.

# Listen address.
MARIO_MAKER_HTTP_ADDR=:20161
# The site's own Postgres (database mario_maker). The schema is created on start.
MARIO_MAKER_DATABASE_URL=postgres://mario_maker:CHANGE_ME@openpak-postgres:5432/mario_maker?sslmode=disable

# Upstream read APIs (docs/api-contract.md); the hosts below are placeholders for the real addresses. Either may be left unset: that game is skipped.
SMM1_API_URL=http://openpak-super-mario-maker:22584
SMM1_API_KEY=
SMM2_API_URL=http://switch-super-mario-maker-2:22334
SMM2_API_KEY=

# Sync cadence: changed courses every interval, a full pass (also detects removed courses) every full interval.
#MARIO_MAKER_SYNC_INTERVAL=60s
#MARIO_MAKER_FULL_SYNC_INTERVAL=10m

# Absolute public base URL, used for Open Graph image links. Derived from the request when unset.
MARIO_MAKER_PUBLIC_URL=https://openmaker.openpak.org
# Thumbnail cache: memory budget in MiB, and an optional directory for a disk copy.
#MARIO_MAKER_THUMB_CACHE_MB=64
#MARIO_MAKER_CACHE_DIR=/app/cache

# Optional: show who is signed in with an OpenPak account. Unset MARIO_MAKER_CORE_BASE_URL to disable.
# The website holds the session; see docs/architecture.md for what this needs.
#MARIO_MAKER_CORE_BASE_URL=http://openpak-account:20000
#MARIO_MAKER_SESSION_COOKIE=opak_session
#MARIO_MAKER_WEBSITE_URL=https://openpak.org

# Optional: bookmark SMM1 courses from the site into the in-game list. Needs sign-in (above) and a service
# that maps an OpenPak account to its Wii U Network ID (docs/api-contract.md, "Bookmarks").
#MARIO_MAKER_LINK_URL=http://openpak-account:20000/internal/wiiu-nnid
#MARIO_MAKER_LINK_KEY=
#MARIO_MAKER_CSRF_SECRET=
